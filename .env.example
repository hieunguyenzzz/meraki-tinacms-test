# Production Environment Variables Template
# Copy these to Dockploy's Environment Variables section

# ============================================
# DATABASE (PostgreSQL)
# ============================================
POSTGRES_USER=tinacms
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=tinacms

# Database connection URL (internal Docker network)
DATABASE_URL=postgresql://tinacms:your_secure_password_here@postgres:5432/tinacms

# ============================================
# GITHUB OAUTH & GIT PROVIDER
# ============================================
# Create PRODUCTION OAuth App: https://github.com/settings/developers
# Homepage URL: https://your-domain.com
# Callback URL: https://your-domain.com/api/auth/callback/github

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Repository details
GITHUB_OWNER=hieunguyenzzz
GITHUB_REPO=meraki-tinacms-test
GITHUB_BRANCH=main

# Personal Access Token for Git operations
# Create at: https://github.com/settings/tokens
# Required scopes: repo (full control)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# ============================================
# AUTH.JS (NextAuth)
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Your production domain
NEXTAUTH_URL=https://your-domain.com

# ============================================
# TINA CLOUD (Optional - if using Tina Cloud)
# ============================================
# These are retrieved from your project at app.tina.io
TINA_CLIENT_ID=
TINA_TOKEN=
TINA_BRANCH=

# ============================================
# CRM / ERP INTEGRATION (contact form -> Lead)
# ============================================
# ERP endpoint that creates a CRM Lead from a contact form submission.
ERP_INQUIRY_URL=https://app.merakiwp.com/inquiry-api/website-inquiry
# Shared secret; must match WEBSITE_INQUIRY_SECRET on the ERP side.
ERP_INQUIRY_SECRET=

# ============================================
# LET'S CONNECT FORM EMAIL (Zoho SMTP)
# ============================================
ZOHO_EMAIL=
ZOHO_PASSWORD=
# Optional, defaults to contact@merakiweddingplanner.com
CONTACT_EMAIL_TO=

# ============================================
# ANALYTICS
# ============================================
# All NEXT_PUBLIC_ and therefore inlined at BUILD time — changing them in
# Dokploy needs a rebuild, not just a restart. `next dev` ignores the code
# defaults, so set them here to test tracking locally; that sends to the live
# property.

# GA4 — carried over from the old site so the history stays continuous.
# OPTIONAL: defaulted in src/lib/analytics.ts, so production tracks without it.
# Set only to point at a different property.
NEXT_PUBLIC_GA_ID=G-152J4BFGVX

# Umami — OFF. The old site's website id no longer exists on the instance
# ("Website not found" from /api/send), so it is not defaulted in code. Fill
# both in with a site that exists to switch it back on; no code change needed.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ============================================
# CANONICAL HOST
# ============================================
# Origin for canonicals, hreflang, OG URLs, robots.txt, sitemap.xml and JSON-LD.
# Defaults to https://merakiweddingplanner.com in code — only set this to point
# at a different host. It MUST be a host that actually serves the site: whatever
# is here is what the site tells Google is its real home.
# NEXT_PUBLIC_SITE_URL=https://merakiweddingplanner.com
